---
// Form lead Permaline embeddato dal CRM Snyffo Hub (GoHighLevel white-label).
// Form universale unico: nhZ9UkL0445WhnKKr0zt (location Compass In 6FE84Sk9Dsgr1jBKXCdb).
// Il dropdown "Sei un..." (Architetto / Impresa) segmenta il lead nel CRM via custom field.
// I lead entrano direttamente nel CRM Compass In. Notifiche e autoresponse gestite lato Snyffo.
import { withBase } from "@/lib/url";
---

<div class="snyffo-form relative">
  <!-- Skeleton mostrato finché l'iframe del form non ha finito di caricare -->
  <div
    class="snyffo-skeleton absolute inset-0 flex flex-col items-center justify-center gap-3 rounded-lg bg-[var(--color-bone)] text-center px-6"
    aria-hidden="true"
  >
    <span class="h-7 w-7 rounded-full border-2 border-[var(--color-line)] border-t-[var(--color-accent)] animate-spin"></span>
    <span class="text-sm text-[var(--color-charcoal)]/70">Caricamento del modulo&hellip;</span>
  </div>

  <iframe
    src="https://api.snyffohub.com/widget/form/nhZ9UkL0445WhnKKr0zt"
    style="width:100%;min-height:1081px;border:none;border-radius:8px;display:block;position:relative;z-index:1"
    id="inline-nhZ9UkL0445WhnKKr0zt"
    data-layout="{'id':'INLINE'}"
    data-trigger-type="alwaysShow"
    data-trigger-value=""
    data-activation-type="alwaysActivated"
    data-activation-value=""
    data-deactivation-type="neverDeactivate"
    data-deactivation-value=""
    data-form-name="Permaline - Form Universale"
    data-height="1081"
    data-layout-iframe-id="inline-nhZ9UkL0445WhnKKr0zt"
    data-form-id="nhZ9UkL0445WhnKKr0zt"
    title="Permaline - Form Universale"
    loading="eager"
  >
  </iframe>

  <p class="mt-4 text-xs text-[var(--color-charcoal)]/70 leading-relaxed">
    Inviando il form acconsenti a essere ricontattato da COMPASSiN S.r.l. per
    rispondere alla tua richiesta. I tuoi dati sono trattati nel rispetto del
    GDPR e della legge svizzera sulla protezione dei dati (nLPD): leggi
    l'<a
      href={withBase("privacy")}
      class="font-semibold text-[var(--color-accent)] underline underline-offset-2 hover:text-[#234f37]"
    >Informativa privacy</a>.
  </p>
</div>

<script is:inline src="https://api.snyffohub.com/js/form_embed.js"></script>

<script is:inline>
  // Watchdog form Snyffo: nasconde lo skeleton quando il form dà segni di vita,
  // e ricarica automaticamente l'iframe se il boot fallisce (evita il "devo ricaricare la pagina").
  (function () {
    var iframe = document.getElementById("inline-nhZ9UkL0445WhnKKr0zt");
    if (!iframe) return;
    var skeleton = iframe.parentElement.querySelector(".snyffo-skeleton");
    var alive = false;
    var retried = false;

    function hideSkeleton() {
      if (skeleton) skeleton.style.display = "none";
    }

    // Il form Snyffo invia postMessage (per il resize) quando la sua app è renderizzata:
    // è il segnale affidabile che il boot è andato a buon fine.
    window.addEventListener("message", function (e) {
      if (e.origin && e.origin.indexOf("snyffohub.com") !== -1) {
        alive = true;
        hideSkeleton();
      }
    });

    // Watchdog: se entro 8s nessun segnale, il boot è fallito → ricarica l'iframe una volta sola.
    setTimeout(function () {
      if (!alive && !retried) {
        retried = true;
        var src = iframe.src;
        iframe.src = "about:blank";
        setTimeout(function () {
          iframe.src = src;
        }, 150);
      }
    }, 8000);

    // Fallback estremo: togli comunque lo skeleton dopo 18s per non lasciarlo appeso.
    setTimeout(hideSkeleton, 18000);
  })();
</script>
