---
import { withBase } from "@/lib/url";

const cards = [
  {
    eyebrow: "Sei un architetto?",
    bodyHtml:
      "Scopri come <strong>mantenere il controllo del dettaglio</strong> ed evitare che un piccolo accesso <em>tradisca la percezione dell'intero ambiente</em>.",
    cta: "Inizia da qui",
    href: withBase("architetti"),
    image: withBase("img/architetti.webp"),
    imageAlt: "Accesso tecnico PERMALINE integrato in ambiente residenziale di alta finitura",
    tone: "dark",
  },
  {
    eyebrow: "Hai un'impresa?",
    bodyHtml:
      "Scopri come eliminare <strong>richiami inutili</strong>, velocizzare la posa e <em>chiudere un lavoro senza doverci tornare sopra</em>.",
    cta: "Inizia da qui",
    href: withBase("imprese"),
    image: withBase("img/imprese.webp"),
    imageAlt: "Posa di sportello PERMALINE in cantiere con linea perimetrale costante",
    tone: "light",
  },
];
---

<section
  class="bg-[var(--color-paper)] py-16 md:py-24"
  aria-labelledby="smistamento-title"
>
  <div class="mx-auto max-w-7xl px-5 md:px-8">
    <div class="text-center">
      <span class="brand-mark mx-auto" aria-hidden="true"></span>
      <p class="eyebrow mb-3">Da dove vuoi partire</p>
      <h2
        id="smistamento-title"
        class="heading text-3xl md:text-4xl leading-tight mb-12 max-w-2xl mx-auto"
      >
        Due percorsi. Lo stesso risultato.
      </h2>
    </div>

    <div class="grid md:grid-cols-2 gap-5 md:gap-6">
      {
        cards.map((card) => (
          <a
            href={card.href}
            class:list={[
              "group block rounded-2xl overflow-hidden transition-all duration-300 border",
              card.tone === "dark"
                ? "card-dark bg-[var(--color-ink)] border-[var(--color-ink)] text-white hover:bg-black"
                : "bg-white border-[var(--color-line)] text-[var(--color-ink)] hover:border-[var(--color-charcoal)]",
            ]}
          >
            <div class="relative aspect-[16/10] overflow-hidden bg-[var(--color-bone)]">
              <img
                src={card.image}
                alt={card.imageAlt}
                width="1200"
                height="750"
                loading="lazy"
                decoding="async"
                class="absolute inset-0 h-full w-full object-cover transition-transform duration-500 group-hover:scale-[1.03]"
              />
              <div
                class:list={[
                  "absolute inset-0",
                  card.tone === "dark"
                    ? "bg-gradient-to-t from-[var(--color-charcoal)]/40 to-transparent"
                    : "",
                ]}
                aria-hidden="true"
              />
            </div>

            <div class="p-7 md:p-9">
              <h3
                class:list={[
                  "heading text-2xl md:text-3xl leading-snug mb-5",
                  card.tone === "dark" ? "!text-white" : "",
                ]}
              >
                {card.eyebrow}
              </h3>
              <p
                class:list={[
                  "text-base md:text-lg leading-relaxed mb-8 body-prose",
                  card.tone === "dark" ? "text-white" : "text-[var(--color-charcoal)]/90",
                ]}
                set:html={card.bodyHtml}
              />
              <span
                class:list={[
                  "inline-flex items-center gap-2 rounded-full px-5 py-2.5 min-h-11 text-sm font-semibold transition-colors",
                  card.tone === "dark"
                    ? "bg-[var(--color-accent)] text-white group-hover:bg-[#234f37]"
                    : "bg-[var(--color-accent)] text-white group-hover:bg-[#234f37]",
                ]}
              >
                {card.cta}
                <svg
                  width="16"
                  height="16"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2"
                  class="transition-transform duration-300 group-hover:translate-x-1"
                  aria-hidden="true"
                >
                  <line x1="5" y1="12" x2="19" y2="12" />
                  <polyline points="12 5 19 12 12 19" />
                </svg>
              </span>
            </div>
          </a>
        ))
      }
    </div>
  </div>
</section>
