---
import { withBase } from "@/lib/url";
const year = new Date().getFullYear();
---

<footer class="bg-[var(--color-charcoal)] text-white/90 mt-auto" aria-labelledby="footer-title">
  <h2 id="footer-title" class="sr-only">Contatti e informazioni</h2>
  <div class="mx-auto max-w-7xl px-5 md:px-8 py-14 md:py-16">
    <div class="grid md:grid-cols-3 gap-10">
      <div>
        <img
          src={withBase("logo/permaline.svg")}
          alt="PERMALINE"
          class="h-12 md:h-14 w-auto mb-5 brightness-0 invert opacity-90"
          width="280"
          height="100"
        />
        <p class="text-sm text-white/75 leading-relaxed max-w-xs">
          Il primo accesso tecnico di precisione per ambienti ad alta finitura.
        </p>
      </div>

      <div>
        <h3 class="eyebrow text-white/65 mb-4">Contatti</h3>
        <ul class="space-y-2 text-sm">
          <li>
            <a
              href="https://wa.me/393755718600"
              target="_blank"
              rel="noopener noreferrer"
              class="hover:text-white text-white/90 transition-colors"
            >
              Tel / WhatsApp: +39 375 571 8600
            </a>
          </li>
          <li>
            <a href="mailto:supporto@compassin.it" class="hover:text-white text-white/90 transition-colors">
              supporto@compassin.it
            </a>
          </li>
          <li>
            <a
              href="https://supportotecnico.compassin.it/"
              target="_blank"
              rel="noopener noreferrer"
              class="hover:text-white text-white/90 transition-colors"
            >
              Supporto tecnico
            </a>
          </li>
        </ul>
      </div>

      <div>
        <h3 class="eyebrow text-white/65 mb-4">Social</h3>
        <ul class="space-y-2 text-sm">
          <li>
            <a
              href="https://www.instagram.com/chiusure_a_filo_compassin"
              target="_blank"
              rel="noopener noreferrer"
              class="hover:text-white text-white/90 transition-colors"
            >
              Instagram
            </a>
          </li>
          <li>
            <a
              href="https://www.youtube.com/@AFILOdiCOMPASSiN"
              target="_blank"
              rel="noopener noreferrer"
              class="hover:text-white text-white/90 transition-colors"
            >
              YouTube
            </a>
          </li>
          <li>
            <a
              href="https://chiusureperimpianti.it"
              target="_blank"
              rel="noopener noreferrer"
              class="hover:text-white text-white/90 transition-colors"
            >
              Blog Chiusure per Impianti
            </a>
          </li>
        </ul>
      </div>
    </div>

    <div class="mt-12 pt-8 border-t border-white/10 flex flex-col md:flex-row items-start md:items-center justify-between gap-4">
      <div class="flex flex-col md:flex-row md:items-center gap-3 md:gap-6">
        <p class="text-xs text-white/65">
          PERMALINE<span class="text-[0.7em] align-top">®</span> &copy; {year} - un prodotto Chiusure A FiLO<span class="text-[0.7em] align-top">®</span>
        </p>
        <nav class="flex items-center gap-4 text-xs" aria-label="Note legali">
          <a
            href={withBase("privacy")}
            class="text-white/75 hover:text-white transition-colors"
          >
            Privacy policy
          </a>
        </nav>
      </div>
      <img
        src={withBase("logo/compassin.png")}
        alt="Chiusure A FiLO"
        class="h-6 w-auto opacity-80"
        width="120"
        height="36"
      />
    </div>
  </div>
</footer>
