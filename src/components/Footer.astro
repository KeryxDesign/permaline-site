---
const year = new Date().getFullYear();
---

<footer class="bg-[var(--color-charcoal)] text-white/90 mt-auto">
  <div class="mx-auto max-w-7xl px-5 md:px-8 py-14 md:py-16">
    <div class="grid md:grid-cols-3 gap-10">
      <div>
        <img
          src="/logo/permaline.svg"
          alt="PERMALINE"
          class="h-8 w-auto mb-4 brightness-0 invert opacity-90"
          width="200"
          height="71"
        />
        <p class="text-sm text-white/70 leading-relaxed max-w-xs">
          Il primo accesso tecnico di precisione per ambienti ad alta finitura.
        </p>
      </div>

      <div>
        <p class="eyebrow text-white/60 mb-4">Contatti</p>
        <ul class="space-y-2 text-sm">
          <li>
            <a
              href="https://wa.me/393755718600"
              target="_blank"
              rel="noopener noreferrer"
              class="hover:text-white text-white/85 transition-colors"
            >
              Tel / WhatsApp: +39 375 571 8600
            </a>
          </li>
          <li>
            <a href="mailto:supporto@compassin.it" class="hover:text-white text-white/85 transition-colors">
              supporto@compassin.it
            </a>
          </li>
          <li>
            <a
              href="https://supportotecnico.compassin.it/"
              target="_blank"
              rel="noopener noreferrer"
              class="hover:text-white text-white/85 transition-colors"
            >
              Supporto tecnico
            </a>
          </li>
        </ul>
      </div>

      <div>
        <p class="eyebrow text-white/60 mb-4">Social</p>
        <ul class="space-y-2 text-sm">
          <li>
            <a
              href="https://www.instagram.com/chiusure_a_filo_compassin"
              target="_blank"
              rel="noopener noreferrer"
              class="hover:text-white text-white/85 transition-colors"
            >
              Instagram
            </a>
          </li>
          <li>
            <a
              href="https://www.youtube.com/@AFILOdiCOMPASSiN"
              target="_blank"
              rel="noopener noreferrer"
              class="hover:text-white text-white/85 transition-colors"
            >
              YouTube
            </a>
          </li>
          <li>
            <a
              href="https://chiusureperimpianti.it"
              target="_blank"
              rel="noopener noreferrer"
              class="hover:text-white text-white/85 transition-colors"
            >
              Blog Chiusure per Impianti
            </a>
          </li>
        </ul>
      </div>
    </div>

    <div class="mt-12 pt-8 border-t border-white/10 flex flex-col md:flex-row items-start md:items-center justify-between gap-4">
      <p class="text-xs text-white/60">
        PERMALINE<span class="text-[0.7em] align-top">®</span> &copy; {year} - un prodotto COMPASSiN
      </p>
      <img
        src="/logo/compassin.png"
        alt="COMPASSiN"
        class="h-6 w-auto opacity-80"
        width="120"
        height="36"
      />
    </div>
  </div>
</footer>
