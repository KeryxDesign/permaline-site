---
---

<div class="fixed bottom-5 left-5 md:bottom-7 md:left-7 z-50">
  <button
    type="button"
    class="h-12 w-12 inline-flex items-center justify-center rounded-full bg-white border border-[var(--color-line)] shadow-[0_8px_20px_-8px_rgba(0,0,0,0.25)] text-[var(--color-charcoal)] hover:border-[var(--color-charcoal)] transition-colors"
    aria-label="Apri pannello accessibilita"
    aria-controls="a11y-panel"
    aria-expanded="false"
    data-a11y-toggle
  >
    <svg width="24" height="24" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
      <circle cx="12" cy="4.5" r="1.8"></circle>
      <path d="M5 8.5h14v2H14v3l2.5 7h-2.2l-1.8-5.5h-1l-1.8 5.5H7.5l2.5-7v-3H5z"></path>
    </svg>
  </button>

  <div
    id="a11y-panel"
    class="hidden absolute bottom-14 left-0 w-72 bg-white border border-[var(--color-line)] rounded-2xl shadow-[0_20px_50px_-20px_rgba(0,0,0,0.25)] p-5"
    role="dialog"
    aria-labelledby="a11y-title"
    data-a11y-panel
  >
    <h2 id="a11y-title" class="heading text-base mb-3">Accessibilita</h2>
    <p class="text-xs text-[var(--color-graphite)] mb-4">
      Le preferenze restano salvate su questo dispositivo.
    </p>

    <fieldset class="space-y-2">
      <legend class="sr-only">Opzioni di accessibilita</legend>

      <label class="flex items-center justify-between gap-3 py-2 cursor-pointer">
        <span class="text-sm font-medium text-[var(--color-charcoal)]">Testo piu grande</span>
        <input type="checkbox" data-a11y="large-text" class="h-5 w-5 accent-[var(--color-accent)]" />
      </label>

      <label class="flex items-center justify-between gap-3 py-2 cursor-pointer">
        <span class="text-sm font-medium text-[var(--color-charcoal)]">Alto contrasto</span>
        <input type="checkbox" data-a11y="high-contrast" class="h-5 w-5 accent-[var(--color-accent)]" />
      </label>

      <label class="flex items-center justify-between gap-3 py-2 cursor-pointer">
        <span class="text-sm font-medium text-[var(--color-charcoal)]">Sottolinea i link</span>
        <input type="checkbox" data-a11y="underline-links" class="h-5 w-5 accent-[var(--color-accent)]" />
      </label>

      <label class="flex items-center justify-between gap-3 py-2 cursor-pointer">
        <span class="text-sm font-medium text-[var(--color-charcoal)]">Riduci animazioni</span>
        <input type="checkbox" data-a11y="reduce-motion" class="h-5 w-5 accent-[var(--color-accent)]" />
      </label>
    </fieldset>

    <button
      type="button"
      class="mt-4 w-full text-xs font-semibold text-[var(--color-graphite)] hover:text-[var(--color-charcoal)] py-2"
      data-a11y-reset
    >
      Ripristina predefinite
    </button>
  </div>
</div>

<script>
  const KEY = "permaline.a11y.v1";
  const toggle = document.querySelector<HTMLButtonElement>("[data-a11y-toggle]");
  const panel = document.querySelector<HTMLDivElement>("[data-a11y-panel]");
  const inputs = document.querySelectorAll<HTMLInputElement>("[data-a11y]");
  const resetBtn = document.querySelector<HTMLButtonElement>("[data-a11y-reset]");

  type Pref = { "large-text": boolean; "high-contrast": boolean; "underline-links": boolean; "reduce-motion": boolean };
  const DEFAULTS: Pref = { "large-text": false, "high-contrast": false, "underline-links": false, "reduce-motion": false };

  const load = (): Pref => {
    try {
      const raw = localStorage.getItem(KEY);
      if (!raw) return { ...DEFAULTS };
      return { ...DEFAULTS, ...JSON.parse(raw) };
    } catch {
      return { ...DEFAULTS };
    }
  };

  const apply = (pref: Pref) => {
    const root = document.documentElement;
    root.classList.toggle("a11y-large-text", pref["large-text"]);
    root.classList.toggle("a11y-high-contrast", pref["high-contrast"]);
    root.classList.toggle("a11y-underline-links", pref["underline-links"]);
    root.classList.toggle("a11y-reduce-motion", pref["reduce-motion"]);
  };

  const save = (pref: Pref) => {
    localStorage.setItem(KEY, JSON.stringify(pref));
    apply(pref);
  };

  // Init
  const initial = load();
  apply(initial);
  inputs.forEach((input) => {
    const key = input.dataset.a11y as keyof Pref;
    input.checked = !!initial[key];
    input.addEventListener("change", () => {
      const next = load();
      next[key] = input.checked;
      save(next);
    });
  });

  // Reset
  resetBtn?.addEventListener("click", () => {
    save({ ...DEFAULTS });
    inputs.forEach((input) => (input.checked = false));
  });

  // Toggle
  toggle?.addEventListener("click", () => {
    const open = panel?.classList.toggle("hidden") === false;
    toggle.setAttribute("aria-expanded", open ? "true" : "false");
  });

  // Chiudi su Escape
  document.addEventListener("keydown", (e) => {
    if (e.key === "Escape" && panel && !panel.classList.contains("hidden")) {
      panel.classList.add("hidden");
      toggle?.setAttribute("aria-expanded", "false");
      toggle?.focus();
    }
  });

  // Chiudi click fuori
  document.addEventListener("click", (e) => {
    if (!panel || panel.classList.contains("hidden")) return;
    const target = e.target as Node;
    if (!panel.contains(target) && !toggle?.contains(target)) {
      panel.classList.add("hidden");
      toggle?.setAttribute("aria-expanded", "false");
    }
  });
</script>
