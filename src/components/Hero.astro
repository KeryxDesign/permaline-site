---
import { withBase } from "@/lib/url";

const slides = [
  { src: withBase("img/hero-1.png"), webp: withBase("img/hero-1.webp"), alt: "Accesso tecnico PERMALINE installato a filo parete" },
  { src: withBase("img/hero-2.png"), webp: withBase("img/hero-2.webp"), alt: "Dettaglio della linea perimetrale costante" },
  { src: withBase("img/hero-3.png"), webp: withBase("img/hero-3.webp"), alt: "Chiusura a filo PERMALINE in ambiente residenziale" },
  { src: withBase("img/hero-4.png"), webp: withBase("img/hero-4.webp"), alt: "Installazione a filo soffitto su superficie continua" },
];
---

<section class="relative overflow-hidden bg-[var(--color-paper)]" aria-label="Introduzione PERMALINE">
  <div class="mx-auto max-w-7xl px-5 md:px-8 pt-12 md:pt-20 pb-12 md:pb-16">
    <div class="grid lg:grid-cols-12 gap-10 lg:gap-12 items-center">
      <div class="lg:col-span-6 max-w-xl">
        <p class="eyebrow mb-5">PERMALINE<span class="ml-0.5 align-top text-[0.6em]">®</span></p>

        <h1 class="heading text-4xl sm:text-5xl lg:text-6xl leading-[1.05] mb-5">
          La linea che protegge il progetto.
        </h1>

        <p class="text-lg md:text-xl text-[var(--color-charcoal)]/90 leading-snug mb-6 font-medium">
          Il primo accesso tecnico di precisione per ambienti ad alta finitura.
        </p>

        <p class="text-base md:text-lg text-[var(--color-charcoal)]/75 leading-relaxed mb-8">
          Valvole, filtri, domotica e accessi tecnici che devono scomparire nella
          superficie e restare precisi nel tempo.
        </p>

        <div class="flex flex-col sm:flex-row gap-3">
          <a
            href={withBase("architetti")}
            class="inline-flex items-center justify-center rounded-full bg-[var(--color-charcoal)] px-6 py-3.5 min-h-11 text-sm font-semibold text-white hover:bg-[var(--color-ink)] transition-colors"
          >
            Sono un architetto
          </a>
          <a
            href={withBase("imprese")}
            class="inline-flex items-center justify-center rounded-full border border-[var(--color-charcoal)] px-6 py-3.5 min-h-11 text-sm font-semibold text-[var(--color-charcoal)] hover:bg-[var(--color-charcoal)] hover:text-white transition-colors"
          >
            Ho un'impresa
          </a>
        </div>
      </div>

      <div class="lg:col-span-6">
        <div
          class="relative aspect-[4/3] md:aspect-[5/4] overflow-hidden rounded-2xl bg-[var(--color-bone)] shadow-[0_1px_2px_rgba(0,0,0,0.04),0_20px_40px_-20px_rgba(0,0,0,0.18)]"
          data-slider
          aria-roledescription="carousel"
          aria-label="Galleria PERMALINE in ambienti reali"
        >
          {
            slides.map((slide, i) => (
              <picture>
                <source type="image/webp" srcset={slide.webp} />
                <img
                  src={slide.src}
                  alt={slide.alt}
                  width="1200"
                  height="900"
                  loading={i === 0 ? "eager" : "lazy"}
                  fetchpriority={i === 0 ? "high" : "auto"}
                  decoding="async"
                  class={`absolute inset-0 h-full w-full object-cover transition-opacity duration-1000 ${
                    i === 0 ? "opacity-100" : "opacity-0"
                  }`}
                  data-slide
                  data-index={i}
                />
              </picture>
            ))
          }

          <div class="absolute bottom-4 left-0 right-0 flex justify-center gap-1" data-dots>
            {
              slides.map((_, i) => (
                <button
                  type="button"
                  class="group h-11 w-11 inline-flex items-center justify-center"
                  aria-label={`Vai alla foto ${i + 1} di ${slides.length}`}
                  aria-current={i === 0 ? "true" : "false"}
                  data-dot
                  data-index={i}
                >
                  <span
                    class={`block h-1.5 rounded-full transition-all ${
                      i === 0 ? "w-8 bg-white" : "w-1.5 bg-white/70"
                    }`}
                    aria-hidden="true"
                    data-dot-pill
                  ></span>
                </button>
              ))
            }
          </div>
        </div>
      </div>
    </div>
  </div>

  <div class="pencil-line mx-auto max-w-7xl"></div>
</section>

<script>
  const slider = document.querySelector("[data-slider]");
  if (slider) {
    const slides = slider.querySelectorAll<HTMLImageElement>("[data-slide]");
    const dots = slider.querySelectorAll<HTMLButtonElement>("[data-dot]");
    const pills = slider.querySelectorAll<HTMLSpanElement>("[data-dot-pill]");
    const reducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
    let current = 0;
    let timer: ReturnType<typeof setInterval> | null = null;

    const show = (next: number) => {
      slides.forEach((el, i) => {
        el.style.opacity = i === next ? "1" : "0";
      });
      dots.forEach((dot, i) => {
        dot.setAttribute("aria-current", i === next ? "true" : "false");
      });
      pills.forEach((pill, i) => {
        if (i === next) {
          pill.classList.remove("w-1.5", "bg-white/70");
          pill.classList.add("w-8", "bg-white");
        } else {
          pill.classList.remove("w-8", "bg-white");
          pill.classList.add("w-1.5", "bg-white/70");
        }
      });
      current = next;
    };

    const start = () => {
      if (reducedMotion) return;
      stop();
      timer = setInterval(() => show((current + 1) % slides.length), 8000);
    };
    const stop = () => {
      if (timer) {
        clearInterval(timer);
        timer = null;
      }
    };

    dots.forEach((dot) => {
      dot.addEventListener("click", () => {
        const idx = Number(dot.dataset.index);
        show(idx);
        start();
      });
    });

    // Pausa su hover (desktop) e su tab nascosta
    slider.addEventListener("mouseenter", stop);
    slider.addEventListener("mouseleave", start);
    document.addEventListener("visibilitychange", () => {
      if (document.hidden) stop();
      else start();
    });

    // Ritarda primo cambio: dai tempo a leggere headline
    if (!reducedMotion) {
      setTimeout(start, 4000);
    }
  }
</script>
