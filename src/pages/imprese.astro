---
import BaseLayout from "@/layouts/BaseLayout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import WhatsAppFloating from "@/components/WhatsAppFloating.astro";
import SnyffoForm from "@/components/SnyffoForm.astro";
import { withBase } from "@/lib/url";

// Perdite "quanto ti costa davvero"
const perdite = [
  {
    title: "Ore che non fatturi",
    body: "Torni in cantiere, lavori, ma non te le pagano.",
  },
  {
    title: "Squadre bloccate",
    body: "Aspetti la chiusura prima di passare al prossimo lavoro.",
  },
  {
    title: "Finiture rifatte",
    body: "Stucco, pittura, regolazioni: lavoro già chiuso da rifare.",
  },
  {
    title: "Materiali consumati",
    body: "Ogni rientro costa ferramenta, consumabili, trasporto.",
  },
  {
    title: "Clienti infastiditi",
    body: "Una telefonata in più al cliente pesa più del lavoro fatto.",
  },
  {
    title: "Margine assottigliato",
    body: "Il guadagno previsto sparisce in un ritorno gratuito.",
  },
];

// 6 benefici "cosa cambia per te"
const benefici = [
  {
    title: "Una posa sola",
    body: "Chiudi e vai avanti. Niente passaggi di verifica successivi.",
  },
  {
    title: "Meno richiami",
    body: "Più clienti soddisfatti. Meno tempo al telefono.",
  },
  {
    title: "Più tempo produttivo",
    body: "Ti concentri sui lavori che rendono, non sui dettagli da rincorrere.",
  },
  {
    title: "Più margine",
    body: "Se non torni gratis, guadagni di più. Punto.",
  },
  {
    title: "Meno stress",
    body: "Niente piccoli problemi che girano in testa la sera.",
  },
  {
    title: "Risultato che regge",
    body: "Il lavoro resta pulito anche dopo anni di apertura.",
  },
];

// 5 step "come funziona"
const steps = [
  {
    n: "1",
    title: "Ci contatti",
    body: "Telefono o WhatsApp.",
  },
  {
    n: "2",
    title: "Verifichiamo il caso",
    body: "Impianto, posizione, misure, foto.",
  },
  {
    n: "3",
    title: "Ti diciamo se è adatta",
    body: "Se non lo è, non perdi tempo.",
  },
  {
    n: "4",
    title: "Ricevi la tua PERMALINE",
    body: "Produzione rapida (5 giorni).",
  },
  {
    n: "5",
    title: "Ti seguiamo fino alla posa",
    body: "Se serve, ci siamo anche in cantiere.",
  },
];

// 3 testimonial imprese
const testimonials = [
  {
    quote:
      "Avevamo problemi di precisione e installazione lenta. Dopo la consegna arrivavano contestazioni. Con COMPASSiN abbiamo velocizzato i tempi e ottenuto un risultato pulito, senza ritorni.",
    name: "Emiliano Carelli",
    studio: "Tecno C.G.E.",
    image: withBase("img/imprese/09-testimonial-carelli.webp"),
    alt: "Emiliano Carelli, Tecno C.G.E.",
  },
  {
    quote:
      "Installazione più veloce e finitura ottima. Consegniamo lavori puliti senza lamentele. Anche tempi di risposta e produzione molto più rapidi.",
    name: "Luca Albertelli",
    studio: "Ambientare",
    image: withBase("img/imprese/10-testimonial-albertelli.webp"),
    alt: "Luca Albertelli, Ambientare",
  },
  {
    quote:
      "Prima dovevo tornare sui lavori e perdevo tempo e soldi. Ora lavoro più veloce, ho meno problemi e più guadagni.",
    name: "Dorin Maftei",
    studio: "Cartongessista",
    image: withBase("img/imprese/11-testimonial-maftei.webp"),
    alt: "Dorin Maftei, cartongessista",
  },
];

// Dove si usa PERMALINE
const usi = [
  "valvole impianti",
  "filtri VMC",
  "trasformatori",
  "centraline domotiche",
  "regolazioni tecniche",
  "piccoli punti di ispezione a soffitto",
  "accessi tecnici a parete ad alta finitura",
];
---

<BaseLayout
  title="PERMALINE® per imprese | Posa una volta sola, niente ritorni"
  description="L'accesso tecnico che chiudi e dimentichi. Per cartongessisti, posatori, imprese di costruzione. Meno richiami, più margine, più tempo produttivo. La prima PERMALINE te la offriamo noi."
>
  <Header />

  <main class="flex-1">

    <!-- ============================================
         HERO
         ============================================ -->
    <section
      class="relative overflow-hidden bg-[var(--color-paper)]"
      aria-label="Introduzione PERMALINE per imprese"
    >
      <div class="mx-auto max-w-7xl px-5 md:px-8 pt-12 md:pt-20 pb-12 md:pb-16">
        <div class="grid lg:grid-cols-12 gap-10 lg:gap-12 items-center">
          <div class="lg:col-span-6 max-w-xl body-prose">
            <p class="eyebrow mb-3">Per imprese e cartongessisti</p>

            <h1
              class="heading text-3xl sm:text-4xl lg:text-5xl leading-[1.1] mb-6"
            >
              Il problema non è posarla.
              <span class="block mt-2 text-[var(--color-accent)]">
                È tornarci sopra.
              </span>
            </h1>

            <p
              class="text-lg md:text-xl text-[var(--color-charcoal)]/90 leading-snug mb-6 font-medium"
            >
              <strong>PERMALINE</strong> è l'accesso tecnico che posi una volta
              sola.
            </p>

            <p
              class="text-base md:text-lg text-[var(--color-charcoal)]/80 leading-relaxed mb-8"
            >
              Quando richiudi un accesso e la linea è quella di una matita
              (uniforme, costante, senza interruzioni) sai che il lavoro è
              fatto. <em>Non ci torni. Passi avanti.</em>
            </p>

            <ul class="space-y-1.5 text-base md:text-lg text-[var(--color-charcoal)]/85 mb-8">
              <li class="flex items-center gap-2">
                <span class="text-[var(--color-accent)] font-bold">→</span>
                Niente ritorni.
              </li>
              <li class="flex items-center gap-2">
                <span class="text-[var(--color-accent)] font-bold">→</span>
                Niente ritocchi.
              </li>
              <li class="flex items-center gap-2">
                <span class="text-[var(--color-accent)] font-bold">→</span>
                Niente ore perse dietro una botola.
              </li>
            </ul>

            <div class="flex flex-col sm:flex-row gap-3">
              <a
                href="#prenota"
                class="inline-flex items-center justify-center rounded-full bg-[var(--color-accent)] px-6 py-3.5 min-h-11 text-sm font-semibold text-white hover:bg-[#234f37] transition-colors"
              >
                Richiedi la tua prima PERMALINE
              </a>
            </div>

            <p class="mt-4 text-sm text-[var(--color-charcoal)]/75">
              Posi, chiudi il lavoro e passi al prossimo cantiere.
            </p>
          </div>

          <div class="lg:col-span-6">
            <div
              class="relative aspect-[4/3] md:aspect-[5/4] overflow-hidden rounded-2xl bg-[var(--color-bone)] shadow-[0_1px_2px_rgba(0,0,0,0.04),0_20px_40px_-20px_rgba(0,0,0,0.18)]"
            >
              <img
                src={withBase("img/imprese/14-prima-foto-new.webp")}
                alt="Accesso tecnico PERMALINE installato a filo: superficie continua dopo la posa"
                width="1600"
                height="1200"
                sizes="(min-width: 1024px) 50vw, 100vw"
                loading="eager"
                fetchpriority="high"
                decoding="async"
                class="absolute inset-0 h-full w-full object-cover"
              />
            </div>
          </div>
        </div>
      </div>

      <div class="pencil-line mx-auto max-w-7xl"></div>
    </section>

    <!-- ============================================
         IL PROBLEMA
         ============================================ -->
    <section
      class="bg-[var(--color-paper)] py-16 md:py-24"
      aria-labelledby="problema-title"
    >
      <div class="mx-auto max-w-7xl px-5 md:px-8">
        <div class="max-w-4xl">
          <span class="brand-mark" aria-hidden="true"></span>
          <p class="eyebrow mb-3">Il problema</p>
          <h2
            id="problema-title"
            class="heading text-3xl md:text-4xl lg:text-5xl leading-tight mb-8"
          >
            Chiudi il cantiere.
            <span class="block mt-2 text-[var(--color-charcoal)]/70">
              Poi arriva la chiamata del cliente.
            </span>
          </h2>
        </div>

        <div class="grid lg:grid-cols-2 gap-10 lg:gap-16 items-center mt-12">
          <div class="body-prose max-w-xl">
            <p class="text-lg text-[var(--color-charcoal)]/90 drop-cap">
              Chiudi il cantiere. Hai già la testa sul lavoro dopo. Poi squilla
              il telefono.
            </p>

            <div class="mt-6 space-y-3 text-base md:text-lg italic text-[var(--color-ink)]/80 leading-relaxed">
              <p>«La botola si è crepata.»</p>
              <p>«Non si apre.»</p>
              <p>«Non è bella da vedere.»</p>
            </div>

            <p class="text-base md:text-lg text-[var(--color-charcoal)]/85 mt-6">
              E per un pezzo da pochi euro perdi mezza giornata. Torni indietro.
              <strong class="pencil-underline">Lavori gratis e rallenti il
              cantiere dopo.</strong>
            </p>

            <p class="text-base md:text-lg text-[var(--color-charcoal)]/85 mt-4">
              Tutto per un dettaglio che doveva sparire.
            </p>
          </div>

          <div class="relative">
            <div
              class="relative aspect-[4/3] overflow-hidden rounded-2xl bg-[var(--color-bone)] shadow-[0_1px_2px_rgba(0,0,0,0.04),0_20px_40px_-20px_rgba(0,0,0,0.15)]"
            >
              <img
                src={withBase("img/imprese/02-telefono-cliente.webp")}
                alt="Telefono che squilla con la chiamata del cliente per problemi alla botola"
                width="1200"
                height="900"
                sizes="(min-width: 1024px) 50vw, 100vw"
                loading="lazy"
                decoding="async"
                class="absolute inset-0 h-full w-full object-cover"
              />
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- ============================================
         QUANTO TI COSTA DAVVERO (DARK)
         ============================================ -->
    <section
      class="bg-[var(--color-ink)] py-16 md:py-24 text-white"
      aria-labelledby="costo-title"
    >
      <div class="mx-auto max-w-7xl px-5 md:px-8">
        <div class="max-w-4xl">
          <span class="brand-mark" aria-hidden="true"></span>
          <p class="eyebrow mb-3" style="color: rgba(255,255,255,0.7);">
            Quanto ti costa davvero
          </p>
          <h2
            id="costo-title"
            class="heading text-3xl md:text-4xl lg:text-5xl leading-tight mb-6 !text-white"
          >
            Forse paghi poco la botola,
            <span class="block mt-2 text-white/70">
              ma non il conto finale.
            </span>
          </h2>
          <p class="text-lg text-white/90 leading-relaxed max-w-2xl">
            Il prezzo della botola conta poco. Conta quello che succede dopo.
            <strong>Ogni volta che torni su una botola:</strong>
          </p>
        </div>

        <div class="grid lg:grid-cols-3 gap-10 lg:gap-12 items-stretch mt-12">
          <div class="lg:col-span-1 grid gap-5">
            <div
              class="relative aspect-[4/3] overflow-hidden rounded-2xl bg-[var(--color-charcoal)] shadow-[0_1px_2px_rgba(0,0,0,0.04),0_20px_40px_-20px_rgba(0,0,0,0.5)]"
            >
              <img
                src={withBase("img/imprese/03-quanto-costa.webp")}
                alt="Calcolatrice e fattura: il costo invisibile dei ritorni in cantiere"
                width="1200"
                height="900"
                sizes="(min-width: 1024px) 33vw, 100vw"
                loading="lazy"
                decoding="async"
                class="absolute inset-0 h-full w-full object-cover"
              />
            </div>
            <div
              class="relative aspect-[4/3] overflow-hidden rounded-2xl bg-[var(--color-charcoal)] shadow-[0_1px_2px_rgba(0,0,0,0.04),0_20px_40px_-20px_rgba(0,0,0,0.5)]"
            >
              <img
                src={withBase("img/imprese/15-quanto-ti-costa-extra.webp")}
                alt="Quanto ti costa davvero un ritorno in cantiere: il dettaglio del problema reale"
                width="1200"
                height="900"
                sizes="(min-width: 1024px) 33vw, 100vw"
                loading="lazy"
                decoding="async"
                class="absolute inset-0 h-full w-full object-cover"
              />
            </div>
          </div>

          <div class="lg:col-span-2 grid sm:grid-cols-2 gap-5">
            {perdite.map((item) => (
              <div
                class="rounded-2xl border border-white/15 bg-white/5 p-6 hover:border-white/40 transition-colors backdrop-blur-sm"
              >
                <h3 class="heading text-base md:text-lg leading-snug mb-2 !text-white">
                  {item.title}
                </h3>
                <p class="text-sm md:text-base text-white/85 leading-relaxed">
                  {item.body}
                </p>
              </div>
            ))}
          </div>
        </div>

        <div class="mt-12 max-w-3xl">
          <blockquote
            class="border-l-4 pl-7 md:pl-9 py-2"
            style="border-left-color: var(--color-accent);"
          >
            <p class="text-lg md:text-xl leading-snug text-white">
              <em>Sembra</em> che la botola costi poco.
              <strong>Ma i problemi li paghi tutti dopo.</strong>
            </p>
          </blockquote>
        </div>
      </div>
    </section>

    <!-- ============================================
         IL VERO PERICOLO
         ============================================ -->
    <section
      class="bg-[var(--color-paper)] py-16 md:py-24"
      aria-labelledby="pericolo-title"
    >
      <div class="mx-auto max-w-7xl px-5 md:px-8">
        <div class="max-w-4xl">
          <span class="brand-mark" aria-hidden="true"></span>
          <p class="eyebrow mb-3">Il vero pericolo</p>
          <h2
            id="pericolo-title"
            class="heading text-3xl md:text-4xl lg:text-5xl leading-tight mb-6"
          >
            «Tanto sono tutte uguali.»
          </h2>
          <p
            class="text-base md:text-lg text-[var(--color-charcoal)]/85 leading-relaxed max-w-2xl"
          >
            È la frase che tiene fermo il mercato da anni. Sembra buon senso.
            <strong><mark>In realtà costa soldi.</mark></strong>
          </p>
        </div>

        <div class="grid lg:grid-cols-2 gap-10 lg:gap-16 items-start mt-12">
          <div class="body-prose">
            <p class="text-base md:text-lg text-[var(--color-charcoal)]/90">
              Quando pensi che una botola valga l'altra, la scelta smette di
              essere tecnica e diventa automatica. Allora scegli:
            </p>
            <ul class="mt-4 space-y-2 text-base md:text-lg text-[var(--color-charcoal)]/85">
              <li class="flex items-start gap-3">
                <span
                  class="mt-2.5 inline-block h-1.5 w-1.5 rounded-full bg-[var(--color-accent)] flex-shrink-0"
                  aria-hidden="true"
                ></span>
                quella che costa meno
              </li>
              <li class="flex items-start gap-3">
                <span
                  class="mt-2.5 inline-block h-1.5 w-1.5 rounded-full bg-[var(--color-accent)] flex-shrink-0"
                  aria-hidden="true"
                ></span>
                quella disponibile subito
              </li>
              <li class="flex items-start gap-3">
                <span
                  class="mt-2.5 inline-block h-1.5 w-1.5 rounded-full bg-[var(--color-accent)] flex-shrink-0"
                  aria-hidden="true"
                ></span>
                quella che hai sempre usato
              </li>
              <li class="flex items-start gap-3">
                <span
                  class="mt-2.5 inline-block h-1.5 w-1.5 rounded-full bg-[var(--color-accent)] flex-shrink-0"
                  aria-hidden="true"
                ></span>
                quella che «tanto basta chiudere il foro»
              </li>
            </ul>
            <p class="text-base md:text-lg text-[var(--color-charcoal)]/90 mt-6">
              Non stai valutando cosa succede dopo la posa. Stai guardando solo
              cosa succede oggi al momento dell'acquisto.
            </p>

            <p class="text-base md:text-lg text-[var(--color-charcoal)]/85 mt-4">
              Ma il vero costo non è quando compri. È quando si crepa, l'anta
              si abbassa, la fuga cambia, devi tornare a sistemarla, il cliente
              si lamenta, perdi tempo che nessuno ti paga.
            </p>

            <p class="text-base md:text-lg text-[var(--color-charcoal)]/90 mt-6">
              <strong>Se hai:</strong>
            </p>
            <ul class="mt-3 space-y-2 text-base md:text-lg text-[var(--color-charcoal)]/85">
              <li class="flex items-start gap-3">
                <span
                  class="mt-2.5 inline-block h-1.5 w-1.5 rounded-full bg-[var(--color-accent)] flex-shrink-0"
                  aria-hidden="true"
                ></span>
                pannello mobile in cartongesso
              </li>
              <li class="flex items-start gap-3">
                <span
                  class="mt-2.5 inline-block h-1.5 w-1.5 rounded-full bg-[var(--color-accent)] flex-shrink-0"
                  aria-hidden="true"
                ></span>
                telaio pensato per adattarsi e non per integrarsi
              </li>
              <li class="flex items-start gap-3">
                <span
                  class="mt-2.5 inline-block h-1.5 w-1.5 rounded-full bg-[var(--color-accent)] flex-shrink-0"
                  aria-hidden="true"
                ></span>
                componenti standard soggetti a usura
              </li>
              <li class="flex items-start gap-3">
                <span
                  class="mt-2.5 inline-block h-1.5 w-1.5 rounded-full bg-[var(--color-accent)] flex-shrink-0"
                  aria-hidden="true"
                ></span>
                sistemi di apertura generici
              </li>
            </ul>
            <p class="text-base md:text-lg text-[var(--color-charcoal)]/90 mt-4">
              <strong>stai scegliendo varianti dello stesso problema.</strong>
            </p>

            <blockquote class="pull-quote mt-8">
              <p>
                Cambia il nome sulla scatola.
                <strong><mark>Non cambia quello che succede in
                cantiere.</mark></strong>
              </p>
            </blockquote>
          </div>

          <div class="relative">
            <div
              class="relative aspect-[4/5] overflow-hidden rounded-2xl bg-[var(--color-bone)] shadow-[0_1px_2px_rgba(0,0,0,0.04),0_20px_40px_-20px_rgba(0,0,0,0.15)]"
            >
              <img
                src={withBase("img/imprese/12-vero-pericolo.webp")}
                alt="Botole standard simili tra loro, varianti dello stesso problema"
                width="900"
                height="1125"
                sizes="(min-width: 1024px) 50vw, 100vw"
                loading="lazy"
                decoding="async"
                class="absolute inset-0 h-full w-full object-cover"
              />
            </div>
          </div>
        </div>

        <div class="mt-14 rounded-2xl bg-[var(--color-bone)] border-2 border-[var(--color-accent)]/30 overflow-hidden">
          <div class="grid md:grid-cols-[1fr_1fr] items-stretch">
            <div class="p-7 md:p-10 flex flex-col justify-center body-prose">
              <p class="eyebrow mb-3">Il test che chiude la discussione</p>
              <p class="text-base md:text-lg text-[var(--color-charcoal)]/90">
                C'è un modo semplice per verificarlo. Si chiama
                <strong class="pencil-underline">linea di matita</strong>.
              </p>
              <p class="text-base md:text-lg text-[var(--color-charcoal)]/85 mt-4">
                Dopo la posa, osserva il perimetro dell'accesso con luce radente.
                Se la fuga è uniforme, costante, sottile come il tratto di una
                matita: il lavoro è fatto bene. Se cambia spessore, si interrompe,
                racconta il cedimento di un materiale: <em>prima o poi ti
                richiamano</em>.
              </p>
            </div>
            <div class="relative aspect-[4/3] md:aspect-auto bg-[var(--color-bone)]">
              <img
                src={withBase("img/imprese/16-linea-matita.webp")}
                alt="Linea di matita: la fuga perimetrale costante che certifica il lavoro fatto bene"
                width="1200"
                height="900"
                sizes="(min-width: 768px) 50vw, 100vw"
                loading="lazy"
                decoding="async"
                class="absolute inset-0 h-full w-full object-cover"
              />
            </div>
          </div>
        </div>

        <div class="mt-12 max-w-3xl body-prose">
          <p class="text-base md:text-lg text-[var(--color-charcoal)]/85 mt-4">
            Non serve uno strumento. Non serve uno specialista. Basta guardare.
            <strong>E quella linea ti dice già adesso se ci tornerai sopra o
            no.</strong>
          </p>
        </div>
      </div>
    </section>

    <!-- ============================================
         COS'È PERMALINE
         ============================================ -->
    <section
      class="bg-[var(--color-bone)] py-16 md:py-24"
      aria-labelledby="permaline-title"
    >
      <div class="mx-auto max-w-7xl px-5 md:px-8">
        <div class="max-w-4xl">
          <span class="brand-mark" aria-hidden="true"></span>
          <p class="eyebrow mb-3">Cos'è PERMALINE</p>
          <h2
            id="permaline-title"
            class="heading text-3xl md:text-4xl lg:text-5xl leading-tight mb-6"
          >
            Non è una botola standard migliorata.
            <span class="block mt-2 text-[var(--color-charcoal)]/70">
              È un sistema progettato per eliminare i problemi tipici delle
              botole tradizionali.
            </span>
          </h2>
        </div>

        <div class="grid lg:grid-cols-12 gap-10 lg:gap-12 items-stretch mt-12">
          <div class="lg:col-span-7 body-prose">
            <p class="text-base md:text-lg text-[var(--color-charcoal)]/90 drop-cap">
              PERMALINE nasce per piccoli impianti a parete e soffitto dove
              servono tre cose insieme: <strong>posa veloce, finitura pulita,
              affidabilità nel tempo</strong>.
            </p>

            <p class="text-base md:text-lg text-[var(--color-charcoal)]/85 mt-4">
              Sotto la finitura c'è:
            </p>
            <ul class="mt-3 space-y-2 text-base md:text-lg text-[var(--color-charcoal)]/90">
              <li class="flex items-start gap-3">
                <span
                  class="mt-2.5 inline-block h-1.5 w-1.5 rounded-full bg-[var(--color-accent)] flex-shrink-0"
                  aria-hidden="true"
                ></span>
                <strong>telaio stabile</strong>
              </li>
              <li class="flex items-start gap-3">
                <span
