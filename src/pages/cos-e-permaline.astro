<script>
  // Mini-slider per la sezione "Perché solo PERMALINE può dirlo" (2 foto: cerniere + premi-apri)
  const brevettiSlider = document.querySelector("[data-brevetti-slider]");
  if (brevettiSlider) {
    const slides = brevettiSlider.querySelectorAll<HTMLImageElement>("[data-brevetti-slide]");
    const dots = brevettiSlider.querySelectorAll<HTMLButtonElement>("[data-brevetti-dot]");
    const pills = brevettiSlider.querySelectorAll<HTMLSpanElement>("[data-brevetti-dot-pill]");
    let current = 0;
    let timer: ReturnType<typeof setInterval> | null = null;

    function show(i: number) {
      slides.forEach((s, idx) => {
        s.style.opacity = idx === i ? "1" : "0";
      });
      dots.forEach((d, idx) => {
        d.setAttribute("aria-current", idx === i ? "true" : "false");
      });
      pills.forEach((p, idx) => {
        p.classList.toggle("bg-white", idx === i);
        p.classList.toggle("bg-white/40", idx !== i);
      });
      current = i;
    }

    function next() {
      show((current + 1) % slides.length);
    }

    function start() {
      stop();
      timer = setInterval(next, 4500);
    }

    function stop() {
      if (timer) {
        clearInterval(timer);
        timer = null;
      }
    }

    dots.forEach((d) => {
      d.addEventListener("click", () => {
        const idx = parseInt(d.dataset.index || "0", 10);
        show(idx);
        start();
      });
    });

    brevettiSlider.addEventListener("mouseenter", stop);
    brevettiSlider.addEventListener("mouseleave", start);
    start();
  }
</script>
