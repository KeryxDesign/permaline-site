---
import BaseLayout from "@/layouts/BaseLayout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import WhatsAppFloating from "@/components/WhatsAppFloating.astro";
import { withBase } from "@/lib/url";

// Limiti botole standard
const limiti = [
  "il telaio non si integra nella costruzione a secco",
  "il pannello perde stabilità nel tempo",
  "i sistemi di apertura sono fragili",
  "le finiture compensano ciò che il sistema non risolve",
];

// 4 esigenze che PERMALINE risolve insieme
const esigenze = [
  "accessibilità all'impianto nel tempo",
  "precisione della finitura",
  "stabilità dopo utilizzi ripetuti",
  "integrazione con progetto e cantiere",
];

// Risultato in cantiere
const risultati = [
  "la linea resta quella che hai lasciato il giorno della finitura",
  "la fuga non cambia quota dopo l'utilizzo",
  "l'anta torna sempre nella stessa posizione millimetrica",
  "la superficie non genera microfratture lungo gli spigoli",
];

// 4 ambienti ideali (ordine richiesto Ecaterina: hospitality prima di residenziale)
const ambienti = [
  {
    title: "Hospitality",
    body: "Hotel, resort, strutture ricettive dove ogni camera, ogni corridoio, ogni area comune racconta il posizionamento della struttura. La superficie è il primo messaggio che il brand trasmette all'ospite, prima ancora del servizio.",
    image: withBase("img/prodotto/06-hospitality.webp"),
    alt: "Dettaglio architettonico hospitality con due accessi tecnici PERMALINE su parete e soffitto",
    objectPosition: "object-center",
  },
  {
    title: "Residenziale di pregio",
    body: "Abitazioni private dove ogni materiale, ogni proporzione, ogni dettaglio è stato scelto con cura. Il committente ha investito nell'idea di perfezione del proprio spazio. Ogni imperfezione, anche piccola, anche tecnica, stona.",
    image: withBase("img/prodotto/05-residenziale.webp"),
    alt: "Ingresso residenziale con accesso tecnico PERMALINE integrato a filo parete",
    objectPosition: "object-right",
  },
  {
    title: "Retail e showroom",
    body: "Ambienti in cui la continuità estetica della superficie comunica il valore del brand prima ancora del prodotto esposto. Un dettaglio fuori controllo non è un problema tecnico: è un messaggio sbagliato.",
    image: withBase("img/prodotto/07-retail.webp"),
    alt: "Showroom retail con due accessi tecnici PERMALINE integrati nel soffitto continuo",
    objectPosition: "object-center",
  },
  {
    title: "Uffici direzionali",
    body: "Spazi in cui ordine, precisione e cura dei dettagli fisici trasmettono solidità professionale. L'immagine dell'organizzazione passa anche attraverso la qualità di ciò che si vede.",
    image: withBase("img/prodotto/08-uffici.webp"),
    alt: "Open space ufficio direzionale con accessi tecnici PERMALINE integrati nel controsoffitto",
    objectPosition: "object-top",
  },
];

// 2 testimonial
const testimonials = [
  {
    quote:
      "Ai miei clienti dico sempre: «Se ho lavorato bene non vi sento più». Il lavoro di progettazione sinergica con Chiusure A FiLO permette di risolvere un problema ancora prima che si presenti.",
    name: "Arch. Alessia Rubino",
    studio: "Milano",
    image: withBase("img/prodotto/10-testimonial-rubino.webp"),
    alt: "Arch. Alessia Rubino, Milano",
  },
  {
    quote:
      "L'installazione è più veloce e permette di ottenere una rifinitura ottima, potendo consegnare al cliente un lavoro estremamente soddisfacente, senza ricevere lamentele.",
    name: "Luca Albertelli",
    studio: "Ambientare",
    image: withBase("img/prodotto/09-testimonial-albertelli.webp"),
    alt: "Luca Albertelli, Ambientare",
  },
];
---

<BaseLayout
  title="Cos'è PERMALINE® | Il primo accesso tecnico di precisione per piccoli impianti"
  description="PERMALINE® non è una botola migliorata. È una categoria nuova. Anta in composito di alluminio, telaio integrato, 4 brevetti. Progettata da cartongessisti per architetti, imprese e committenti che pretendono precisione."
>
  <Header />

  <main class="flex-1">

    <!-- ============================================
         HERO
         ============================================ -->
    <section
      class="relative overflow-hidden bg-[var(--color-paper)]"
      aria-label="Cos'è PERMALINE"
    >
      <div class="mx-auto max-w-7xl px-5 md:px-8 pt-12 md:pt-20 pb-12 md:pb-16">
        <div class="grid lg:grid-cols-12 gap-10 lg:gap-12 items-center">
          <div class="lg:col-span-6 max-w-xl body-prose">
            <p class="pre-headline mb-4">
              PERMALINE<span class="ml-0.5 align-top text-[0.45em]">®</span>
            </p>

            <h1
              class="heading text-3xl sm:text-4xl lg:text-5xl leading-[1.1] mb-6"
            >
              Il primo accesso tecnico di precisione
              <span class="block mt-2 text-[var(--color-accent)]">
                per piccoli impianti ad alta finitura.
              </span>
            </h1>

            <p
              class="text-lg md:text-xl text-[var(--color-charcoal)]/90 leading-snug mb-6 font-medium"
            >
              Non una botola migliore.
              <strong class="pencil-underline">Una categoria nuova.</strong>
            </p>

            <p
              class="text-base md:text-lg text-[var(--color-charcoal)]/80 leading-relaxed mb-8"
            >
              PERMALINE® nasce per risolvere un problema che il mercato ha
              normalizzato da anni: i piccoli accessi tecnici vengono trattati
              come dettagli di poco conto, e sono <em>esattamente</em> il punto
              in cui il lavoro perde precisione, credibilità e controllo.
            </p>

            <div class="flex flex-col sm:flex-row gap-3">
              <a
                href={withBase("architetti")}
                class="inline-flex items-center justify-center rounded-full bg-[var(--color-accent)] px-6 py-3.5 min-h-11 text-sm font-semibold text-white hover:bg-[#234f37] transition-colors"
              >
                Sono un architetto
              </a>
              <a
                href={withBase("imprese")}
                class="inline-flex items-center justify-center rounded-full border-2 border-[var(--color-accent)] px-6 py-3.5 min-h-11 text-sm font-semibold text-[var(--color-accent)] hover:bg-[var(--color-accent)] hover:text-white transition-colors"
              >
                Ho un'impresa
              </a>
            </div>
          </div>

          <div class="lg:col-span-6">
            <div
              class="relative aspect-[4/3] md:aspect-[5/4] overflow-hidden rounded-2xl bg-[var(--color-bone)] shadow-[0_1px_2px_rgba(0,0,0,0.04),0_20px_40px_-20px_rgba(0,0,0,0.18)]"
            >
              <img
                src={withBase("img/prodotto/01-hero.webp")}
                alt="PERMALINE® installata su superficie continua: il primo accesso tecnico di precisione"
                width="1600"
                height="1200"
                sizes="(min-width: 1024px) 50vw, 100vw"
                loading="eager"
                fetchpriority="high"
                decoding="async"
                class="absolute inset-0 h-full w-full object-cover"
              />
            </div>
          </div>
        </div>
      </div>

      <div class="pencil-line mx-auto max-w-7xl"></div>
    </section>

    <!-- ============================================
         IL PROBLEMA NON È PICCOLO
         ============================================ -->
    <section
      class="bg-[var(--color-paper)] py-16 md:py-24"
      aria-labelledby="problema-title"
    >
      <div class="mx-auto max-w-7xl px-5 md:px-8">
        <div class="max-w-4xl">
          <span class="brand-mark" aria-hidden="true"></span>
          <p class="eyebrow mb-3">Il problema non è piccolo</p>
          <h2
            id="problema-title"
            class="heading text-3xl md:text-4xl lg:text-5xl leading-tight mb-6"
          >
            Valvole, filtri, sensori, trasformatori, domotica.
            <span class="block mt-2 text-[var(--color-charcoal)]/70">
              I piccoli impianti sono ovunque.
            </span>
          </h2>
        </div>

        <div class="max-w-3xl mt-10 body-prose prose-manifesto">
          <p class="text-lg text-[var(--color-charcoal)]/90 drop-cap">
            E quasi sempre finiscono su pareti e soffitti che dovrebbero
            restare continui, puliti, ordinati. Quando vengono chiusi con
            soluzioni scelte per abitudine, disponibilità o prezzo, il
            risultato si vede. Non subito. <strong>Spesso dopo la consegna,
            quando è già tardi.</strong>
          </p>
          <p class="text-base md:text-lg text-[var(--color-charcoal)]/85">
            Ma c'è un modo per saperlo prima ancora che il problema si
            manifesti. Si chiama
            <strong class="pencil-underline">linea di matita</strong>.
          </p>
        </div>
      </div>
    </section>

    <!-- ============================================
         LA LINEA CHE DICE TUTTO
         ============================================ -->
    <section
      class="bg-[var(--color-bone)] py-16 md:py-24"
      aria-labelledby="linea-title"
    >
      <div class="mx-auto max-w-7xl px-5 md:px-8">
        <div class="max-w-4xl">
          <span class="brand-mark" aria-hidden="true"></span>
          <p class="eyebrow mb-3">La linea che dice tutto</p>
          <h2
            id="linea-title"
            class="heading text-3xl md:text-4xl lg:text-5xl leading-tight mb-6"
          >
            La linea perimetrale di un accesso tecnico
            <span class="block mt-2 text-[var(--color-accent)]">
              non è un'opinione. È un dato fisico.
            </span>
          </h2>
        </div>

        <div class="grid lg:grid-cols-2 gap-10 lg:gap-16 items-start mt-12">
          <div class="body-prose">
            <p class="text-base md:text-lg text-[var(--color-charcoal)]/90">
              Si osserva, si misura, si fotografa, si confronta nel tempo.
            </p>
            <p class="text-base md:text-lg text-[var(--color-charcoal)]/85 mt-4">
              Quando un <strong>architetto</strong> ispeziona un dettaglio
              costruttivo, il suo occhio va istintivamente alla linea.
            </p>
            <p class="text-base md:text-lg text-[var(--color-charcoal)]/85 mt-3">
              Quando un <strong>posatore</strong> verifica il proprio lavoro
              dopo la posa, controlla la linea.
            </p>
            <p class="text-base md:text-lg text-[var(--color-charcoal)]/85 mt-3">
              Quando un <strong>committente</strong> osserva la superficie del
              suo ambiente, spesso senza sapere che sta guardando un accesso
              tecnico, vede la linea. <em>E da quella linea trae un giudizio
              complessivo</em>.
            </p>

            <blockquote class="pull-quote mt-8">
              <p>
                <strong>È una linea di matita? È sempre la stessa?</strong>
                Se non è una linea di matita costante (oggi, dopo cento
                aperture, dopo cinque anni),
                <mark>non è lo standard PERMALINE®.</mark>
              </p>
            </blockquote>
          </div>

          <div class="relative">
            <div
              class="relative aspect-[3/4] overflow-hidden rounded-2xl bg-[var(--color-bone)] shadow-[0_1px_2px_rgba(0,0,0,0.04),0_20px_40px_-20px_rgba(0,0,0,0.15)]"
            >
              <img
                src={withBase("img/prodotto/02-linea-matita.webp")}
                alt="Linea di matita: la fuga perimetrale costante che certifica il lavoro fatto bene"
                width="900"
                height="1200"
                sizes="(min-width: 1024px) 50vw, 100vw"
                loading="lazy"
                decoding="async"
                class="absolute inset-0 h-full w-full object-cover object-top"
              />
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- ============================================
         BOTOLE STANDARD: PERCHÉ NON FUNZIONANO (DARK)
         ============================================ -->
    <section
      class="bg-[var(--color-ink)] py-16 md:py-24 text-white"
      aria-labelledby="standard-title"
    >
      <div class="mx-auto max-w-7xl px-5 md:px-8">
        <div class="max-w-4xl">
          <span class="brand-mark" aria-hidden="true"></span>
          <p class="eyebrow mb-3" style="color: rgba(255,255,255,0.7);">
            Perché con le botole standard non funziona
          </p>
          <h2
            id="standard-title"
            class="heading text-3xl md:text-4xl lg:text-5xl leading-tight mb-6 !text-white"
          >
            Non è colpa della posa.
            <span class="block mt-2 text-white/70">
              È colpa del sistema.
            </span>
          </h2>
          <p class="text-lg text-white/90 leading-relaxed max-w-3xl">
            Le botole tradizionali in cartongesso nascono tutte dalla stessa
            logica costruttiva: telai simili, stessi materiali, stessi
            componenti adattati da altri prodotti. <strong>Cambia il nome. Non
            cambia il principio.</strong>
          </p>
        </div>

        <div class="grid lg:grid-cols-2 gap-10 lg:gap-16 items-start mt-12">
          <div>
            <p class="text-base md:text-lg text-white/85 leading-relaxed mb-4">
              Da quella logica arrivano sempre gli stessi limiti:
            </p>
            <ul class="space-y-3 text-white/90">
              {limiti.map((l) => (
                <li class="flex items-start gap-3">
                  <svg
                    width="16"
                    height="16"
                    viewBox="0 0 16 16"
                    fill="none"
                    stroke="#ef4444"
                    stroke-width="2.5"
                    stroke-linecap="round"
                    class="mt-1 flex-shrink-0"
                    aria-hidden="true"
                  >
                    <line x1="3" y1="3" x2="13" y2="13" />
                    <line x1="13" y1="3" x2="3" y2="13" />
                  </svg>
                  {l}
                </li>
              ))}
            </ul>

            <p class="text-base md:text-lg text-white/85 leading-relaxed mt-6">
              Per questo lo scuretto si deforma, la complanarità si perde, la
              stuccatura cede. <strong>E la linea di matita scompare</strong>:
              prima all'angolo, poi lungo i lati, poi dovunque si concentri una
              tensione o un utilizzo ripetuto.
            </p>

            <blockquote
              class="mt-8 border-l-4 pl-7 md:pl-9 py-2"
              style="border-left-color: var(--color-accent);"
            >
              <p class="text-lg md:text-xl leading-snug text-white">
                Non sono difetti occasionali. Sono <strong>limiti
                strutturali</strong>. Puoi cambiare marca. Non cambia il
                comportamento.
              </p>
            </blockquote>
          </div>

          <div class="grid grid-cols-2 gap-4">
            <div
              class="relative aspect-[3/4] overflow-hidden rounded-2xl bg-[var(--color-charcoal)]"
            >
              <img
                src={withBase("img/prodotto/11-botola-standard-1.webp")}
                alt="Limite tipico di una botola standard: pannello fuori complanarità"
                width="800"
                height="1066"
                sizes="(min-width: 1024px) 25vw, 50vw"
                loading="lazy"
                decoding="async"
                class="absolute inset-0 h-full w-full object-cover"
              />
            </div>
            <div
              class="relative aspect-[3/4] overflow-hidden rounded-2xl bg-[var(--color-charcoal)] sm:mt-12"
            >
              <img
                src={withBase("img/prodotto/12-botola-standard-2.webp")}
                alt="Limite tipico di una botola standard: discontinuità lungo il perimetro"
                width="800"
                height="1066"
                sizes="(min-width: 1024px) 25vw, 50vw"
                loading="lazy"
                decoding="async"
                class="absolute inset-0 h-full w-full object-cover"
              />
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- ============================================
         COS'È PERMALINE
         ============================================ -->
    <section
      class="bg-[var(--color-paper)] py-16 md:py-24"
      aria-labelledby="permaline-title"
    >
      <div class="mx-auto max-w-7xl px-5 md:px-8">
        <div class="max-w-4xl">
          <span class="brand-mark" aria-hidden="true"></span>
          <p class="eyebrow mb-3">Cos'è PERMALINE</p>
          <h2
            id="permaline-title"
            class="heading text-3xl md:text-4xl lg:text-5xl leading-tight mb-6"
          >
            Un accesso tecnico di precisione
            <span class="block mt-2 text-[var(--color-charcoal)]/70">
              progettato per i piccoli impianti che devono restare
              ispezionabili senza compromettere la continuità della superficie.
            </span>
          </h2>
        </div>

        <div class="grid lg:grid-cols-12 gap-10 lg:gap-12 items-start mt-12">
          <div class="lg:col-span-7 body-prose">
            <p class="text-base md:text-lg text-[var(--color-charcoal)]/90 drop-cap">
              Non chiude semplicemente un foro. Risolve insieme quattro
              esigenze che nelle soluzioni standard entrano quasi sempre in
              conflitto:
            </p>

            <ul class="mt-4 space-y-2 text-[var(--color-charcoal)]/90">
              {esigenze.map((e) => (
                <li class="flex items-start gap-3">
                  <span
                    class="mt-1.5 inline-block h-1.5 w-1.5 rounded-full bg-[var(--color-accent)] flex-shrink-0"
                    aria-hidden="true"
                  ></span>
                  <strong>{e}</strong>
                </li>
              ))}
            </ul>

            <h3 class="heading text-xl md:text-2xl mt-10 mb-4">
              Come funziona: un sistema, non una somma di pezzi.
            </h3>

            <p class="text-base md:text-lg text-[var(--color-charcoal)]/85">
              L'anta non è in cartongesso: è in <strong>composito di
              alluminio</strong>. Il telaio è studiato per integrarsi nella
              costruzione a secco. Il sistema di apertura non è un componente
              generico adattato: fa parte del sistema fin dalla progettazione.
            </p>

            <p class="text-base md:text-lg text-[var(--color-charcoal)]/90 mt-4">
              <strong>Anta, telaio, apertura e logica di posa lavorano insieme
              come un unico corpo.</strong>
            </p>

            <p class="text-base md:text-lg text-[var(--color-charcoal)]/85 mt-6">
              Il risultato in cantiere:
            </p>
            <ul class="mt-3 space-y-2 text-[var(--color-charcoal)]/90">
              {risultati.map((r) => (
                <li class="flex items-start gap-3">
                  <span class="text-[var(--color-accent)] font-bold flex-shrink-0">→</span>
                  {r}
                </li>
              ))}
            </ul>

            <p class="text-lg md:text-xl text-[var(--color-ink)] font-medium mt-8">
              <strong>Tradotto:</strong>
              <mark>la linea di matita che vedi alla consegna è quella che
              ritrovi dopo un anno, dopo cinque anni, dopo cento aperture.</mark>
            </p>
          </div>

          <div class="lg:col-span-5">
            <div
              class="relative aspect-[3/4] overflow-hidden rounded-2xl bg-[var(--color-bone)] shadow-[0_1px_2px_rgba(0,0,0,0.04),0_20px_40px_-20px_rgba(0,0,0,0.18)]"
            >
              <img
                src={withBase("img/prodotto/03-cos-e-permaline.webp")}
                alt="Sistema PERMALINE: anta, telaio, apertura e logica di posa come unico corpo"
                width="900"
                height="1200"
                sizes="(min-width: 1024px) 40vw, 100vw"
                loading="lazy"
                decoding="async"
                class="absolute inset-0 h-full w-full object-cover"
              />
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- ============================================
         4 BREVETTI + STORIA FONDATORI
         ============================================ -->
    <section
      class="bg-[var(--color-bone)] py-16 md:py-24"
      aria-labelledby="brevetti-title"
    >
      <div class="mx-auto max-w-7xl px-5 md:px-8">
        <div class="grid lg:grid-cols-12 gap-10 lg:gap-12 items-center">
          <div class="lg:col-span-5 order-2 lg:order-1">
            <div
              class="relative aspect-[4/5] overflow-hidden rounded-2xl bg-[var(--color-bone)] shadow-[0_1px_2px_rgba(0,0,0,0.04),0_20px_40px_-20px_rgba(0,0,0,0.18)]"
              data-brevetti-slider
              aria-roledescription="carousel"
              aria-label="Dettagli del sistema PERMALINE"
            >
              <picture>
                <img
                  src={withBase("img/prodotto/18-perche-solo-cerniere.webp")}
                  alt="Dettaglio cerniere del sistema PERMALINE: precisione meccanica del telaio integrato"
                  width="900"
                  height="1125"
                  sizes="(min-width: 1024px) 40vw, 100vw"
                  loading="lazy"
                  decoding="async"
                  class="absolute inset-0 h-full w-full object-cover transition-opacity duration-1000 opacity-100"
                  data-brevetti-slide
                  data-index="0"
                />
              </picture>
              <picture>
                <img
                  src={withBase("img/prodotto/19-perche-solo-premi-apri.webp")}
                  alt="Dettaglio del sistema di apertura premi-apri PERMALINE: meccanismo integrato a filo"
                  width="900"
                  height="1125"
                  sizes="(min-width: 1024px) 40vw, 100vw"
                  loading="lazy"
                  decoding="async"
                  class="absolute inset-0 h-full w-full object-cover transition-opacity duration-1000 opacity-0"
                  data-brevetti-slide
                  data-index="1"
                />
              </picture>

              <div class="absolute bottom-4 left-0 right-0 flex justify-center gap-1" data-brevetti-dots>
                <button
                  type="button"
                  class="group h-11 w-11 inline-flex items-center justify-center"
                  aria-label="Vai alla foto 1 di 2"
                  aria-current="true"
                  data-brevetti-dot
                  data-index="0"
                >
                  <span class="h-1.5 w-6 rounded-full bg-white transition-colors" data-brevetti-dot-pill></span>
                </button>
                <button
                  type="button"
                  class="group h-11 w-11 inline-flex items-center justify-center"
                  aria-label="Vai alla foto 2 di 2"
                  aria-current="false"
                  data-brevetti-dot
                  data-index="1"
                >
                  <span class="h-1.5 w-6 rounded-full bg-white/40 transition-colors" data-brevetti-dot-pill></span>
                </button>
              </div>
            </div>
          </div>

          <div class="lg:col-span-7 order-1 lg:order-2 body-prose">
            <span class="brand-mark" aria-hidden="true"></span>
            <p class="eyebrow mb-3">Perché solo PERMALINE può dirlo</p>
            <h2
              id="brevetti-title"
              class="heading text-3xl md:text-4xl lg:text-5xl leading-tight mb-6"
            >
              <strong>4 brevetti.</strong>
              <span class="block mt-2 text-[var(--color-charcoal)]/70">
                E una conoscenza che non si compra.
              </span>
            </h2>

            <p class="text-base md:text-lg text-[var(--color-charcoal)]/90">
              Dietro la semplicità del risultato ci sono 4 brevetti sviluppati
              all'interno delle <strong>Chiusure A FiLO® di
              Chiusure A FiLO®</strong>.
            </p>

            <p class="text-base md:text-lg text-[var(--color-charcoal)]/85 mt-4">
              PERMALINE® è stata progettata da chi, prima di progettarla,
