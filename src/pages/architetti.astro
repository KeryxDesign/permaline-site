// 5 step "come funziona"
const steps = [
  {
    n: "1",
    title: "Ci contatti",
    body: "Ci invii il tuo caso, il contesto o il progetto da valutare.",
  },
  {
    n: "2",
    title: "Fai un confronto tecnico dedicato",
    body: "Parli con un tecnico che conosce davvero la costruzione a secco e sa leggere le criticità del dettaglio.",
  },
  {
    n: "3",
    title: "Verifichiamo il progetto",
    body: "Analizziamo posizione, impianto, supporto, finiture, visibilità e modalità d'uso.",
  },
  {
    n: "4",
    title: "Capisci subito se PERMALINE è la soluzione giusta",
    body: "Se è coerente con il tuo progetto, la realizziamo su misura. Se non lo è, te lo diciamo subito.",
  },
  {
    n: "5",
    title: "Ricevi proposta e indicazioni operative",
    body: "Definiamo integrazione, dimensioni e supporto fino alla consegna.",
  },
