// 6 benefici architetto
const benefici = [
  {
    title: "Controllo progettuale reale",
    body: "L'accesso tecnico smette di essere una decisione residuale di cantiere. Lo definisci tu, con gli stessi criteri con cui hai definito tutto il resto.",
  },
  {
    title: "Linea costante",
    body: "Lo scuretto resta controllato. La fuga resta uniforme. La superficie non cambia quota dopo la finitura.",
  },
  {
    title: "Coerenza estetica",
    body: "A parete o a soffitto, l'accesso si integra nel disegno invece di sembrare un elemento aggiunto dopo.",
  },
  {
    title: "Supporto tecnico specializzato",
    body: "Ti confronti con un team che conosce il cantiere a secco e ragiona con te in termini progettuali, non solo commerciali.",
  },
  {
    title: "Risultato che regge nel tempo",
    body: "Aperture ripetute, manutenzioni e assestamenti fisiologici non devono trasformarsi in crepe, micro-movimenti o perdita di precisione. Non fra un mese e nemmeno fra 5 anni.",
  },
  {
    title: "Meno ritorni su un dettaglio già deciso",
    body: "Definisci bene una volta. Eviti brutte sorprese e non sei costretto a tornarci sopra dopo.",
