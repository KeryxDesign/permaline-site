  },
  {
    title: "Sopralluoghi non previsti",
    body: "Devi tornare in cantiere per verificare un dettaglio che doveva essere già risolto.",
  },
  {
    title: "Tempo perso in coordinamento",
    body: "Messaggi tra impresa, fornitore, posatore e progettista per capire chi deve intervenire.",
  },
  {
    title: "Ritocchi e ripristini",
    body: "Stucco, pittura, regolazioni, smontaggi, nuove verifiche.",
  },
  {
    title: "Rallentamenti",
    body: "Un punto piccolo blocca chiusure, consegna o saldo finale del lavoro.",
  },
  {
    title: "Danno reputazionale",
    body: "Il committente non pensa: \"problema della botola\". Pensa: \"qui il progetto non è stato controllato bene\".",
  },
