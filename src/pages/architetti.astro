    body: "L'anta non resta perfettamente a filo. Con la luce radente emerge subito.",
    image: withBase("img/architetti/04-botola-limite-1.webp"),
    alt: "Botola standard con anta non a filo, dettaglio della discontinuità superficiale",
  },
  {
    title: "Instabilità dei bordi",
    body: "Micro-movimenti e tensioni generano crepe e discontinuità lungo il perimetro.",
    image: withBase("img/architetti/05-botola-limite-2.webp"),
    alt: "Botola con crepe e discontinuità lungo il bordo perimetrale",
  },
  {
    title: "Irregolarità nell'apertura",
    body: "Dopo utilizzi ripetuti, la chiusura perde precisione e il dettaglio cambia.",
    image: withBase("img/architetti/06-botola-limite-3.webp"),
    alt: "Botola con chiusura irregolare dopo utilizzo ripetuto",
  },
