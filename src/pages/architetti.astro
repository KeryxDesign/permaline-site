    alt: "Arch. Alberto De Lorenzo, De Base Architettura Milano",
  },
];

// Dove si usa PERMALINE
const usi = [
  "valvole impianti",
  "filtri VMC",
  "trasformatori",
  "centraline domotiche",
  "regolazioni tecniche",
  "piccoli punti di ispezione a soffitto",
  "accessi tecnici a parete ad alta finitura",
];

// Condizioni "quando ha senso"
const condizioni = [
  "piccoli accessi tecnici",
  "superfici di pregio",
  "alta visibilità del dettaglio",
  "uso reale nel tempo",
  "attenzione forte a pulizia, continuità e percezione",
];
---

<BaseLayout
  title="PERMALINE® per architetti | Mantieni il controllo del dettaglio"
  description="L'accesso tecnico di precisione per architetti che progettano ambienti ad alta finitura. Linea perimetrale costante, coerenza estetica, risultato che regge nel tempo. Prenota un confronto tecnico dedicato."
>
  <Header />

  <main class="flex-1">

    <!-- ============================================
         HERO
         ============================================ -->
    <section
      class="relative overflow-hidden bg-[var(--color-paper)]"
      aria-label="Introduzione PERMALINE per architetti"
    >
      <div class="mx-auto max-w-7xl px-5 md:px-8 pt-12 md:pt-20 pb-12 md:pb-16">
        <div class="grid lg:grid-cols-12 gap-10 lg:gap-12 items-center">
          <div class="lg:col-span-6 max-w-xl body-prose">
            <p class="eyebrow mb-3">Per architetti</p>

            <h1
              class="heading text-3xl sm:text-4xl lg:text-5xl leading-[1.1] mb-6"
            >
              Il problema non è nascondere l'impianto.
              <span class="block mt-2 text-[var(--color-accent)]">
                È perdere il controllo del dettaglio.
              </span>
            </h1>

            <p
              class="text-lg md:text-xl text-[var(--color-charcoal)]/90 leading-snug mb-6 font-medium"
            >
              <strong>PERMALINE</strong> è il primo accesso tecnico di precisione
              per ambienti ad alta finitura.
            </p>

            <p
              class="text-base md:text-lg text-[var(--color-charcoal)]/80 leading-relaxed mb-8"
            >
              Quando progetti superfici pulite e dettagli coerenti, non puoi
              lasciare proprio l'accesso tecnico alla logica del
              <em>«si è sempre fatto così»</em>. PERMALINE® protegge la
              <strong>linea di matita</strong>. Non come promessa estetica, ma
              come parametro tecnico verificabile.
            </p>

            <div class="flex flex-col sm:flex-row gap-3">
              <a
                href="#prenota"
                class="inline-flex items-center justify-center rounded-full bg-[var(--color-accent)] px-6 py-3.5 min-h-11 text-sm font-semibold text-white hover:bg-[#234f37] transition-colors"
              >
                Prenota un confronto tecnico
              </a>
            </div>

            <p class="mt-4 text-sm text-[var(--color-charcoal)]/75">
              Nessuna proposta standard. Prima capiamo il progetto.
            </p>
          </div>

          <div class="lg:col-span-6">
            <div
              class="relative aspect-[4/3] md:aspect-[5/4] overflow-hidden rounded-2xl bg-[var(--color-bone)] shadow-[0_1px_2px_rgba(0,0,0,0.04),0_20px_40px_-20px_rgba(0,0,0,0.18)]"
            >
              <img
                src={withBase("img/architetti/01-hero.webp")}
                alt="Accesso tecnico PERMALINE integrato in ambiente residenziale di alta finitura"
                width="1600"
                height="1200"
                sizes="(min-width: 1024px) 50vw, 100vw"
                loading="eager"
                fetchpriority="high"
                decoding="async"
                class="absolute inset-0 h-full w-full object-cover"
              />
            </div>
          </div>
        </div>
      </div>

      <div class="pencil-line mx-auto max-w-7xl"></div>
    </section>

    <!-- ============================================
         IL PROBLEMA
         ============================================ -->
    <section
      class="bg-[var(--color-paper)] py-16 md:py-24"
      aria-labelledby="problema-title"
    >
      <div class="mx-auto max-w-7xl px-5 md:px-8">
        <div class="max-w-4xl">
          <span class="brand-mark" aria-hidden="true"></span>
          <p class="eyebrow mb-3">Il problema</p>
          <h2
            id="problema-title"
            class="heading text-3xl md:text-4xl lg:text-5xl leading-tight mb-8"
          >
            Progetti tutto per far sparire il superfluo.
            <span class="block mt-2 text-[var(--color-charcoal)]/70">
              Poi resta in vista proprio il dettaglio tecnico che avrebbe dovuto
              sparire.
            </span>
          </h2>
        </div>

        <div class="grid lg:grid-cols-2 gap-10 lg:gap-16 items-start mt-12">
          <div class="body-prose prose-manifesto max-w-xl">
            <p class="text-lg text-[var(--color-charcoal)]/90 drop-cap">
              Quante volte succede? Definisci materiali, luci, fughe,
              proporzioni, continuità delle superfici. Poi arriva il momento di
              gestire un piccolo accesso impiantistico (valvole, filtri,
              quadri, domotica, componenti tecnici necessari) e quella scelta
              finisce fuori dal tuo controllo.
            </p>
            <p class="text-base md:text-lg text-[var(--color-charcoal)]/85">
              Che si tratti di una botola in cartongesso, di un accesso tecnico
              a parete o di un punto ispezionabile a soffitto, la scelta
              sbagliata resta visibile.
            </p>
            <p class="text-base md:text-lg text-[var(--color-charcoal)]/85">
              Viene sottovalutata. Viene delegata. Viene
              <strong class="pencil-underline">rimandata</strong>
              (a quando è troppo tardi).
            </p>
          </div>

          <div class="relative">
            <div
              class="relative aspect-[3/4] overflow-hidden rounded-2xl bg-[var(--color-bone)] shadow-[0_1px_2px_rgba(0,0,0,0.04),0_20px_40px_-20px_rgba(0,0,0,0.15)]"
            >
              <img
                src={withBase("img/architetti/02-linea-perimetrale.webp")}
                alt="Linea perimetrale costante di un accesso tecnico PERMALINE"
                width="900"
                height="1200"
                sizes="(min-width: 1024px) 50vw, 100vw"
                loading="lazy"
                decoding="async"
                class="absolute inset-0 h-full w-full object-cover"
              />
            </div>
          </div>
        </div>

        <div class="max-w-3xl mt-12">
          <blockquote class="pull-quote">
            <p>
              Il committente vede la linea. Trae un giudizio sulla cura
              dell'ambiente. <strong><mark>Quel giudizio ricade su chi ha
              progettato.</mark></strong>
            </p>
          </blockquote>
        </div>
      </div>
    </section>

    <!-- ============================================
         PERCHÉ È UN COSTO REALE (DARK)
         ============================================ -->
    <section
      class="bg-[var(--color-ink)] py-16 md:py-24 text-white"
      aria-labelledby="costo-title"
    >
      <div class="mx-auto max-w-7xl px-5 md:px-8">
        <div class="max-w-4xl">
          <span class="brand-mark" aria-hidden="true"></span>
          <p class="eyebrow mb-3" style="color: rgba(255,255,255,0.7);">
            Perché è un costo reale
          </p>
          <h2
            id="costo-title"
            class="heading text-3xl md:text-4xl lg:text-5xl leading-tight mb-6 !text-white"
          >
            Il prezzo della botola è una voce di acquisto.
            <span class="block mt-2 text-white/70">
              Il costo vero nasce dopo.
            </span>
          </h2>
          <p
            class="text-lg text-white/90 leading-relaxed max-w-2xl"
          >
            Se l'accesso tecnico resta fuori linea, crea crepe, si abbassa,
            sporge o non richiude bene, il problema non rimane sulla botola.
            <strong class="pencil-underline-white">Ricade sul progetto.</strong>
          </p>
        </div>

        <div class="grid lg:grid-cols-3 gap-10 lg:gap-12 items-stretch mt-12">
          <div class="lg:col-span-1">
            <div
              class="relative h-full min-h-[400px] overflow-hidden rounded-2xl bg-[var(--color-charcoal)] shadow-[0_1px_2px_rgba(0,0,0,0.04),0_20px_40px_-20px_rgba(0,0,0,0.5)]"
            >
              <img
                src={withBase("img/architetti/20-perche-costo-reale-new.webp")}
                alt="Dettaglio del costo reale: accesso tecnico fuori linea che ricade sul progetto"
                width="900"
                height="1200"
                sizes="(min-width: 1024px) 33vw, 100vw"
                loading="lazy"
                decoding="async"
                class="absolute inset-0 h-full w-full object-cover"
              />
            </div>
          </div>

          <div class="lg:col-span-2 grid sm:grid-cols-2 gap-5">
            {costReale.map((item) => (
              <div
                class="rounded-2xl border border-white/15 bg-white/5 p-6 hover:border-white/40 transition-colors backdrop-blur-sm"
              >
                <h3 class="heading text-base md:text-lg leading-snug mb-2 !text-white">
                  {item.title}
                </h3>
                <p class="text-sm md:text-base text-white/85 leading-relaxed">
                  {item.body}
                </p>
              </div>
            ))}
          </div>
        </div>

        <div class="mt-12 max-w-3xl">
          <blockquote
            class="border-l-4 pl-7 md:pl-9 py-2"
            style="border-left-color: var(--color-accent);"
          >
            <p class="text-lg md:text-xl leading-snug text-white">
              Una botola economica può costare poco da comprare e molto da
              gestire. <strong>Non stai scegliendo solo un accesso tecnico. Stai
              decidendo se quel dettaglio lavorerà per il progetto o contro il
              progetto.</strong>
            </p>
          </blockquote>
        </div>

        <div class="mt-10">
          <a
            href="#prenota"
            class="inline-flex items-center justify-center rounded-full bg-[var(--color-accent)] px-6 py-3.5 min-h-11 text-sm font-semibold text-white hover:bg-[#234f37] transition-colors"
          >
            Prenota un confronto tecnico sul tuo progetto
          </a>
        </div>
      </div>
    </section>

    <!-- ============================================
         BOTOLA STANDARD - I LIMITI
         ============================================ -->
    <section
      class="bg-[var(--color-paper)] py-16 md:py-24"
      aria-labelledby="limiti-title"
    >
      <div class="mx-auto max-w-7xl px-5 md:px-8">
        <div class="max-w-4xl">
          <span class="brand-mark" aria-hidden="true"></span>
          <p class="eyebrow mb-3">I limiti dello standard</p>
          <h2
            id="limiti-title"
            class="heading text-3xl md:text-4xl lg:text-5xl leading-tight mb-6"
          >
            Botola standard:
            <span class="block mt-2 text-[var(--color-charcoal)]/70">
              il limite che compromette il progetto.
            </span>
          </h2>
          <p
            class="text-base md:text-lg text-[var(--color-charcoal)]/85 leading-relaxed max-w-2xl"
          >
            La botola in cartongesso è lo standard più diffuso. Ma nasce per
            chiudere un foro, non per integrarsi in una superficie ad alta
            finitura. Per questo, nel tempo, mostra sempre gli stessi limiti.
          </p>
        </div>

        <div class="grid md:grid-cols-3 gap-6 mt-12">
          {limiti.map((limite) => (
            <div
              class="rounded-2xl overflow-hidden border border-[var(--color-line)] bg-white hover:border-[var(--color-charcoal)] transition-colors"
            >
              <div class="relative aspect-[3/4] overflow-hidden bg-[var(--color-bone)]">
                <img
                  src={limite.image}
                  alt={limite.alt}
                  width="600"
                  height="800"
                  sizes="(min-width: 1024px) 33vw, (min-width: 640px) 50vw, 100vw"
                  loading="lazy"
                  decoding="async"
                  class="absolute inset-0 h-full w-full object-cover object-center"
                />
              </div>
              <div class="p-6">
                <h3 class="heading text-lg md:text-xl leading-snug mb-2">
                  {limite.title}
                </h3>
                <p class="text-sm md:text-base text-[var(--color-charcoal)]/85 leading-relaxed">
                  {limite.body}
                </p>
              </div>
            </div>
          ))}
        </div>

        <div class="mt-12 max-w-3xl body-prose">
          <p class="text-base md:text-lg text-[var(--color-charcoal)]/90">
            Non sono difetti occasionali. Sono <strong><mark>limiti
            strutturali</mark></strong>. Puoi cambiare marca. Non cambia il
            comportamento.
          </p>
          <p class="text-base md:text-lg text-[var(--color-charcoal)]/85 mt-4">
            Se il contesto richiede precisione, il problema non è scegliere una
            botola migliore. <em>È riconoscere che la botola standard è lo
            strumento sbagliato.</em>
          </p>
        </div>
      </div>
    </section>

    <!-- ============================================
         IL VERO NEMICO
         ============================================ -->
    <section
      class="bg-[var(--color-ink)] py-16 md:py-24 text-white"
      aria-labelledby="nemico-title"
    >
      <div class="mx-auto max-w-7xl px-5 md:px-8">
        <div class="max-w-4xl">
          <span class="brand-mark" aria-hidden="true"></span>
          <p
            class="eyebrow mb-3"
            style="color: rgba(255,255,255,0.7);"
          >
            Cosa cambia davvero
          </p>
          <h2
            id="nemico-title"
            class="heading text-3xl md:text-4xl lg:text-5xl leading-tight mb-6 !text-white"
          >
            Il vero nemico non è la botola sbagliata.
            <span class="block mt-2 text-white/70">
              È l'idea che «tanto le botole sono tutte uguali».
            </span>
          </h2>
          <p class="text-base md:text-lg text-white/85 leading-relaxed max-w-3xl">
            È questa convinzione che ha abbassato il livello di attenzione sugli
            accessi tecnici. Quando si ragiona così, la scelta viene fatta
            all'ultimo minuto in base a:
          </p>
        </div>

        <ul class="grid sm:grid-cols-2 gap-3 mt-8 max-w-3xl text-white/90">
          <li class="flex items-start gap-3">
            <span
              class="mt-1.5 inline-block h-1.5 w-1.5 rounded-full bg-[var(--color-accent)] flex-shrink-0"
              aria-hidden="true"
            ></span>
            cosa c'è disponibile
          </li>
          <li class="flex items-start gap-3">
            <span
              class="mt-1.5 inline-block h-1.5 w-1.5 rounded-full bg-[var(--color-accent)] flex-shrink-0"
              aria-hidden="true"
            ></span>
            cosa costa meno
          </li>
          <li class="flex items-start gap-3">
            <span
              class="mt-1.5 inline-block h-1.5 w-1.5 rounded-full bg-[var(--color-accent)] flex-shrink-0"
              aria-hidden="true"
            ></span>
            cosa usa sempre l'impresa
          </li>
          <li class="flex items-start gap-3">
            <span
              class="mt-1.5 inline-block h-1.5 w-1.5 rounded-full bg-[var(--color-accent)] flex-shrink-0"
              aria-hidden="true"
            ></span>
            cosa arriva subito
          </li>
        </ul>

        <div class="grid lg:grid-cols-2 gap-10 lg:gap-16 items-start mt-14">
          <div class="body-prose max-w-xl">
            <p class="text-base md:text-lg text-white/90 leading-relaxed">
              Ma un accesso per un locale tecnico nascosto non ha le stesse
              esigenze di un accesso visibile in un soggiorno, in una hall o in
              un corridoio curato.
            </p>

            <blockquote
              class="mt-6 border-l-4 pl-6 md:pl-8 py-2"
              style="border-left-color: var(--color-accent);"
            >
              <p class="text-lg md:text-xl leading-snug text-white font-medium">
                Non tutte le chiusure filo muro risolvono lo stesso problema.
              </p>
            </blockquote>

            <p class="text-base md:text-lg text-white/85 leading-relaxed mt-6">
              Le botole d'ispezione standard servono a chiudere un foro.
              PERMALINE nasce per gestire situazioni precise: superfici curate
              e continue, punti molto visibili, aperture nel tempo per
              manutenzione.
            </p>
            <p class="text-base md:text-lg text-white/90 leading-relaxed mt-4">
              Se il progetto è curato nei dettagli, scegliere «una qualsiasi»
              non è neutralità. <strong>È un rischio.</strong>
            </p>
          </div>

          <div class="grid grid-cols-2 gap-4">
            <div
              class="relative aspect-[3/4] overflow-hidden rounded-2xl bg-[var(--color-charcoal)]"
            >
              <img
                src={withBase("img/architetti/07-vero-nemico-1.webp")}
                alt="Esempio di accesso tecnico mal integrato in superficie curata"
                width="800"
                height="1066"
                sizes="(min-width: 1024px) 25vw, 50vw"
                loading="lazy"
                decoding="async"
                class="absolute inset-0 h-full w-full object-cover"
              />
            </div>
            <div
