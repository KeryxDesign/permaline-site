---
import "@/styles/global.css";
import { withBase } from "@/lib/url";
import CookieBanner from "@/components/CookieBanner.astro";
import AccessibilityWidget from "@/components/AccessibilityWidget.astro";

interface Props {
  title?: string;
  description?: string;
  ogImage?: string;
}

const {
  title = "PERMALINE® - La linea che protegge il progetto",
  description = "Il primo accesso tecnico di precisione per ambienti ad alta finitura. Valvole, filtri, domotica e accessi tecnici che devono scomparire nella superficie e restare precisi nel tempo.",
  ogImage = withBase("img/hero-1.png"),
} = Astro.props;

const canonical = new URL(Astro.url.pathname, Astro.site).toString();
const ogImageAbsolute = new URL(ogImage, Astro.site).toString();

// Indicizzazione: noindex su preview (GitHub Pages), index su permaline.it
const isProduction = process.env.DEPLOY_TARGET === 'production';

const jsonLd = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "Organization",
      "@id": "https://www.compassin.it/#organization",
      name: "Compassin",
      url: "https://www.compassin.it/",
      logo: new URL(withBase("logo/compassin.png"), Astro.site).toString(),
      sameAs: [
        "https://www.instagram.com/chiusure_a_filo_compassin",
        "https://www.youtube.com/@AFILOdiCOMPASSiN",
        "https://chiusureperimpianti.it",
      ],
      contactPoint: {
        "@type": "ContactPoint",
        telephone: "+39-375-571-8600",
        contactType: "technical support",
        email: "supporto@compassin.it",
        areaServed: "IT",
        availableLanguage: ["Italian"],
      },
    },
    {
      "@type": "Brand",
      "@id": canonical + "#brand",
      name: "PERMALINE",
      logo: new URL(withBase("logo/permaline.svg"), Astro.site).toString(),
      parentOrganization: { "@id": "https://www.compassin.it/#organization" },
    },
    {
      "@type": "Product",
      "@id": canonical + "#product",
      name: "PERMALINE",
      category: "Accessi tecnici a filo parete e soffitto",
      description:
        "Standard di accesso tecnico di precisione per ambienti ad alta finitura. Sportelli di ispezione, accessi a valvole, filtri e domotica progettati per scomparire nella superficie e restare precisi nel tempo.",
      brand: { "@id": canonical + "#brand" },
      manufacturer: { "@id": "https://www.compassin.it/#organization" },
      image: [
        new URL(withBase("img/hero-1.png"), Astro.site).toString(),
        new URL(withBase("img/hero-2.png"), Astro.site).toString(),
        new URL(withBase("img/hero-3.png"), Astro.site).toString(),
      ],
      url: canonical,
    },
    {
      "@type": "WebSite",
      "@id": canonical + "#website",
      url: canonical,
      name: "PERMALINE",
      inLanguage: "it-IT",
      publisher: { "@id": "https://www.compassin.it/#organization" },
    },
  ],
};
---

<!doctype html>
<html lang="it">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="generator" content={Astro.generator} />
    <meta name="theme-color" content="#373a36" />

    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />

    {!isProduction && (
      <meta name="robots" content="noindex, nofollow" />
    )}

    <!-- Anti-clickjacking: impedisce embedding in iframe esterni -->
    <meta http-equiv="Content-Security-Policy" content="frame-ancestors 'none'" />

    {isProduction && (
      <>
        <script is:inline>
          // Google Consent Mode v2 — default deny, override con consenso salvato
          window.dataLayer = window.dataLayer || [];
          function gtag(){dataLayer.push(arguments);}
          window.gtag = gtag;

          var analyticsConsent = 'denied';
          try {
            var saved = JSON.parse(localStorage.getItem('permaline.cookie.v1') || 'null');
            if (saved && saved.analytics === 'granted') analyticsConsent = 'granted';
          } catch (e) {}

          gtag('consent', 'default', {
            'ad_storage': 'denied',
            'ad_user_data': 'denied',
            'ad_personalization': 'denied',
            'analytics_storage': analyticsConsent,
            'functionality_storage': 'granted',
            'security_storage': 'granted',
            'wait_for_update': 500
          });

          gtag('js', new Date());
          gtag('config', 'G-BTEK711MN0', { anonymize_ip: true });
        </script>
        <script is:inline async src="https://www.googletagmanager.com/gtag/js?id=G-BTEK711MN0"></script>
      </>
    )}

    <link rel="icon" type="image/png" href={withBase("favicon.png")} />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="PERMALINE | Compassin" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImageAbsolute} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="900" />
    <meta property="og:image:alt" content="Accesso tecnico PERMALINE installato a filo parete" />
    <meta property="og:locale" content="it_IT" />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageAbsolute} />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap"
      rel="stylesheet"
    />

    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />

    <!-- UTM capture (persistente in sessione) + GA4 conversion event sui form lead -->
    <script is:inline>
      (function () {
        var UTM_KEYS = ['utm_source', 'utm_medium', 'utm_campaign', 'utm_term', 'utm_content'];
        var EXTRA_KEYS = ['initial_referrer', 'landing_page'];

        // 1) Salva UTM + referrer + landing_page in sessionStorage al primo arrivo
        try {
          var params = new URLSearchParams(window.location.search);
          UTM_KEYS.forEach(function (k) {
            var v = params.get(k);
            if (v && !sessionStorage.getItem(k)) sessionStorage.setItem(k, v);
          });
          if (!sessionStorage.getItem('initial_referrer')) {
            sessionStorage.setItem('initial_referrer', document.referrer || '(direct)');
          }
          if (!sessionStorage.getItem('landing_page')) {
            sessionStorage.setItem('landing_page', window.location.pathname);
          }
        } catch (e) {}

        // 2) Popola hidden field nei form Formsubmit + invia evento GA4 al submit
        document.addEventListener('DOMContentLoaded', function () {
          var forms = document.querySelectorAll('form[action*="formsubmit.co"]');
          forms.forEach(function (form) {
            // Inietta UTM + referrer + landing_page come hidden
            UTM_KEYS.concat(EXTRA_KEYS).forEach(function (name) {
              if (form.querySelector('input[name="' + name + '"]')) return;
              var input = document.createElement('input');
              input.type = 'hidden';
              input.name = name;
              try { input.value = sessionStorage.getItem(name) || ''; } catch (e) { input.value = ''; }
              form.appendChild(input);
            });

            // GA4 conversion event al submit (parte anche con consent denied, come modeled)
            form.addEventListener('submit', function () {
              if (typeof window.gtag === 'function') {
                var formType = form.getAttribute('data-form-type') || 'unknown';
                window.gtag('event', 'generate_lead', {
                  form_type: formType,
                  value: 1,
                  currency: 'EUR'
                });
              }
            });
          });
        });
      })();
    </script>
  </head>
  <body class="min-h-screen flex flex-col">
    <slot />
    <CookieBanner />
    <AccessibilityWidget />
  </body>
</html>
